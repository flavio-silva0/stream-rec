# ========================================================
# Configurações do Neo4j (Local, Docker ou Sandbox / AuraDB)
# ========================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ========================================================
# Configurações do Redis (Local, Docker ou Redis Cloud)
# ========================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=60

# ========================================================
# Configurações da Aplicação
# ========================================================
PROJECT_NAME="StreamRec - Plataforma de Recomendação"
VERSION=1.0.0
USE_MOCK_FALLBACK=true
